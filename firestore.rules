rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default safety net (catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive definitions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // Helper functions for entity validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'streak', 'lastActiveDate', 'highScore', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'socialLink', 'streak', 'lastActiveDate', 'highScore', 'theme', 'biometricsEnabled', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && (!data.keys().contains('socialLink') || data.socialLink == null || (data.socialLink is string && data.socialLink.size() <= 200))
        && data.streak is number && data.streak >= 0
        && data.lastActiveDate is string && data.lastActiveDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.highScore is number && data.highScore >= 0
        && data.theme is string && data.theme.size() <= 20
        && (data.get('biometricsEnabled', false) is bool)
        && (data.get('notificationsEnabled', false) is bool);
    }

    function isValidLeaderboardScore(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'difficulty', 'matrixSize', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'socialLink', 'score', 'difficulty', 'matrixSize', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && (!data.keys().contains('socialLink') || data.socialLink == null || (data.socialLink is string && data.socialLink.size() <= 200))
        && data.score is number && data.score >= 0
        && data.difficulty is string && (data.difficulty == 'easy' || data.difficulty == 'medium' || data.difficulty == 'hard' || data.difficulty == 'insane')
        && data.matrixSize is number && (data.matrixSize == 3 || data.matrixSize == 4 || data.matrixSize == 5);
    }

    function isValidMultiplayerMatch(data) {
      return data.keys().hasAll(['matchId', 'type', 'status', 'player1Id', 'player1Name', 'target', 'formulaDisplay', 'formulaSize', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['matchId', 'type', 'status', 'player1Id', 'player1Name', 'player2Id', 'player2Name', 'target', 'formulaDisplay', 'formulaSize', 'grid', 'winnerId', 'winnerName', 'createdAt', 'updatedAt'])
        && data.matchId is string && data.matchId.size() <= 128
        && (data.type == 'random' || data.type == 'room')
        && (data.status == 'waiting' || data.status == 'active' || data.status == 'completed' || data.status == 'abandoned')
        && data.player1Id is string && data.player1Id.size() <= 128
        && data.player1Name is string && data.player1Name.size() >= 2 && data.player1Name.size() <= 30
        && (!data.keys().contains('player2Id') || data.player2Id == null || (data.player2Id is string && data.player2Id.size() <= 128))
        && (!data.keys().contains('player2Name') || data.player2Name == null || (data.player2Name is string && data.player2Name.size() <= 30))
        && data.target is number
        && data.formulaDisplay is string && data.formulaDisplay.size() <= 100
        && data.formulaSize is number
        && (!data.keys().contains('winnerId') || data.winnerId == null || (data.winnerId is string && data.winnerId.size() <= 128))
        && (!data.keys().contains('winnerName') || data.winnerName == null || (data.winnerName is string && data.winnerName.size() <= 30));
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'socialLink', 'streak', 'lastActiveDate', 'highScore', 'theme', 'biometricsEnabled', 'notificationsEnabled', 'updatedAt'])
        );
      
      allow delete: if false;
    }

    // Rules for Leaderboard Scores
    match /scores/{scoreId} {
      allow get, list: if true;
      
      allow create: if isSignedIn()
        && isValidId(scoreId)
        && incoming().userId == request.auth.uid
        && isValidLeaderboardScore(incoming())
        && incoming().createdAt == request.time;
        
      // Allow authenticated players to delete scores to enforce top-10 list cleanups
      allow delete: if isSignedIn();
      allow update: if false;
    }

    // Rules for Multiplayer Matches
    match /matches/{matchId} {
      allow get, list: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(matchId)
        && incoming().player1Id == request.auth.uid
        && isValidMultiplayerMatch(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn()
        && isValidId(matchId)
        && isValidMultiplayerMatch(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Case 1: Player 2 joins a waiting match
          (existing().status == 'waiting' && incoming().status == 'active' && incoming().player2Id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['player2Id', 'player2Name', 'status', 'updatedAt']))
          // Case 2: One of the players solves the puzzle and wins
          || (existing().status == 'active' && incoming().status == 'completed' && (request.auth.uid == existing().player1Id || request.auth.uid == existing().player2Id) && incoming().winnerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winnerId', 'winnerName', 'updatedAt']))
          // Case 3: Player abandons
          || (incoming().status == 'abandoned' && (request.auth.uid == existing().player1Id || (existing().keys().contains('player2Id') && request.auth.uid == existing().player2Id)) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
        
      allow delete: if false;
    }
  }
}
