rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default safety net (catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive definitions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // Helper functions for entity validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'streak', 'lastActiveDate', 'highScore', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'socialLink', 'streak', 'lastActiveDate', 'highScore', 'theme', 'biometricsEnabled', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && (!data.keys().contains('socialLink') || data.socialLink == null || (data.socialLink is string && data.socialLink.size() <= 200))
        && data.streak is number && data.streak >= 0
        && data.lastActiveDate is string && data.lastActiveDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.highScore is number && data.highScore >= 0
        && data.theme is string && data.theme.size() <= 20
        && (data.get('biometricsEnabled', false) is bool)
        && (data.get('notificationsEnabled', false) is bool);
    }

    function isValidLeaderboardScore(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'difficulty', 'matrixSize', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'socialLink', 'score', 'difficulty', 'matrixSize', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && (!data.keys().contains('socialLink') || data.socialLink == null || (data.socialLink is string && data.socialLink.size() <= 200))
        && data.score is number && data.score >= 0
        && data.difficulty is string && (data.difficulty == 'easy' || data.difficulty == 'medium' || data.difficulty == 'hard' || data.difficulty == 'insane')
        && data.matrixSize is number && (data.matrixSize == 3 || data.matrixSize == 4 || data.matrixSize == 5);
    }

    function isValidMultiplayerMatch(data) {
      return data.keys().hasAll(['matchId', 'type', 'playMode', 'status', 'player1Id', 'player1Name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'matchId', 'type', 'playMode', 'status', 'player1Id', 'player1Name', 
          'player2Id', 'player2Name', 'player1Score', 'player2Score', 
          'player1Selection', 'player2Selection', 'currentRound', 'expiresAt', 
          'winnerId', 'winnerName', 'grid', 'target', 'formulaDisplay', 'formulaSize', 
          'advanceA', 'advanceB', 'advanceC', 'advanceD', 'advanceE', 'rematchRequestedBy', 'rematchAccepted', 
          'rematchDeclined', 'createdAt', 'updatedAt'
        ])
        && data.matchId is string && data.matchId.size() <= 128
        && (data.type == 'random' || data.type == 'room')
        && (data.playMode == 'normal' || data.playMode == 'advance')
        && (data.status == 'waiting' || data.status == 'active' || data.status == 'completed' || data.status == 'abandoned')
        && data.player1Id is string && data.player1Id.size() <= 128
        && data.player1Name is string && data.player1Name.size() >= 2 && data.player1Name.size() <= 30
        && (!data.keys().contains('player2Id') || data.player2Id == null || (data.player2Id is string && data.player2Id.size() <= 128))
        && (!data.keys().contains('player2Name') || data.player2Name == null || (data.player2Name is string && data.player2Name.size() <= 30))
        && (!data.keys().contains('winnerId') || data.winnerId == null || (data.winnerId is string && data.winnerId.size() <= 128))
        && (!data.keys().contains('winnerName') || data.winnerName == null || (data.winnerName is string && data.winnerName.size() <= 30))
        && (!data.keys().contains('target') || data.target == null || data.target is number)
        && (!data.keys().contains('formulaDisplay') || data.formulaDisplay == null || (data.formulaDisplay is string && data.formulaDisplay.size() <= 100))
        && (!data.keys().contains('formulaSize') || data.formulaSize == null || data.formulaSize is number)
        && (!data.keys().contains('advanceA') || data.advanceA == null || data.advanceA is number)
        && (!data.keys().contains('advanceB') || data.advanceB == null || data.advanceB is number)
        && (!data.keys().contains('advanceC') || data.advanceC == null || data.advanceC is number)
        && (!data.keys().contains('advanceD') || data.advanceD == null || data.advanceD is number)
        && (!data.keys().contains('advanceE') || data.advanceE == null || data.advanceE is number)
        && (!data.keys().contains('rematchRequestedBy') || data.rematchRequestedBy == null || (data.rematchRequestedBy is string && data.rematchRequestedBy.size() <= 128))
        && (!data.keys().contains('rematchAccepted') || data.rematchAccepted == null || data.rematchAccepted is bool)
        && (!data.keys().contains('rematchDeclined') || data.rematchDeclined == null || data.rematchDeclined is bool)
        && (!data.keys().contains('expiresAt') || data.expiresAt == null || data.expiresAt is number)
        && (!data.keys().contains('currentRound') || data.currentRound == null || data.currentRound is number);
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'socialLink', 'streak', 'lastActiveDate', 'highScore', 'theme', 'biometricsEnabled', 'notificationsEnabled', 'updatedAt'])
        );
      
      allow delete: if false;
    }

    // Rules for Leaderboard Scores
    match /scores/{scoreId} {
      allow get, list: if true;
      
      allow create: if isSignedIn()
        && isValidId(scoreId)
        && incoming().userId == request.auth.uid
        && isValidLeaderboardScore(incoming())
        && incoming().createdAt == request.time;
        
      // Allow authenticated players to delete scores to enforce top-10 list cleanups
      allow delete: if isSignedIn();
      allow update: if false;
    }

    // Rules for Multiplayer Matches
    match /matches/{matchId} {
      allow get, list: if true;
      
      allow create: if isValidId(matchId)
        && isValidMultiplayerMatch(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isValidId(matchId)
        && isValidMultiplayerMatch(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
        
      allow delete: if false;
    }
  }
}
